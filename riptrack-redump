SECTOR_SIZE = 2352
ISO_SECTOR_SIZE = 2048
SECTORS_PER_SECOND = 75
MMC_TOC_ALLOCATION_LENGTH = 804
SAMPLE_RATE = 44100
CHANNELS = 2
