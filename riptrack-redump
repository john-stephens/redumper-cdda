# cdparanoia TOC
# ----------------------------------------------------------------------

def parse_cdparanoia_toc(text):
    tracks = []

    pattern = re.compile(
        r"^\s*"
        r"(\d+)\.\s+"
        r"(\d+)\s+"
        r"\[(\d+:\d+\.\d+)\]\s+"
        r"(-?\d+)\s+"
        r"\[(\d+:\d+\.\d+)\]"
    )

    for raw_line in text.splitlines():
        match = pattern.match(raw_line)

        if not match:
            continue

        number = int(match.group(1))
        length = int(match.group(2))
        length_msf = match.group(3)
        begin = int(match.group(4))
        begin_msf = match.group(5)

        tracks.append(
            {
                "number": number,
                "length": length,
                "length_msf": length_msf,
                "begin": begin,
                "begin_msf": begin_msf,
                "end": begin + length,
            }
        )

    if not tracks:
        raise RuntimeError(
            "Could not parse any audio tracks from "
            "cdparanoia -Q output."
        )

    return tracks


def read_disc_toc(device, verbose=False):
    command = [
        "cdparanoia",
        "-Q",
        "-d",
        device,
    ]

    if verbose:
        print(
            "Reading audio track layout with cdparanoia..."
        )

    process = subprocess.Popen(
        command,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    stdout, stderr = communicate_with_process(
        process
    )

    result = subprocess.CompletedProcess(
        command,
        process.returncode,
        stdout,
        stderr,
    )

    if result.returncode != 0:
        details = "\n".join(
            part
            for part in (
                result.stdout.strip(),
                result.stderr.strip(),
            )
            if part
        )

        raise RuntimeError(
            "cdparanoia -Q failed"
            + (
                "\n\n" + details
                if details
                else ""
            )
        )

    output = (
        (result.stdout or "")
        + "\n"
        + (result.stderr or "")
    )

    return parse_cdparanoia_toc(
        output
    )


def find_track(tracks, number):
    for track in tracks:
        if track["number"] == number:
            return track

    available = ", ".join(
        str(track["number"])
        for track in tracks
    )

    raise RuntimeError(
        f"Audio track {number} was not found.\n"
        f"Available audio tracks: {available}"
    )


def find_requested_track(tracks, number):
    if number != 0:
        return find_track(
            tracks,
            number,
        )

    track_one = find_track(
        tracks,
        1,
    )
    length = track_one["begin"]

    if length <= 0:
        raise RuntimeError(
            "Track 0 does not exist: Track 1 starts at LBA 0."
        )

    return {
        "number": 0,
        "length": length,
        "length_msf": sectors_to_msf(length),
        "begin": 0,
        "begin_msf": "00:00.00",
        "end": track_one["begin"],
    }


def parse_track_selection(value):
    if re.fullmatch(r"\d+", value):
        number = int(value)
        return {
            "start": number,
            "end": number,
        }

    match = re.fullmatch(
        r"(\d*)-(\d*)",
        value,
    )

    if not match or not any(match.groups()):
        raise argparse.ArgumentTypeError(
            "track must be N, N-M, -M, or N-"
        )

    return {
        "start": (
            int(match.group(1))
            if match.group(1)
            else None
        ),
        "end": (
            int(match.group(2))
            if match.group(2)
            else None
        ),
    }


def resolve_track_selection(
    tracks,
    selection,
):
    regular_numbers = [
        track["number"]
        for track in tracks
    ]

    if not regular_numbers:
        raise RuntimeError(
            "No audio tracks are available."
        )

    start = selection["start"]
    end = selection["end"]

    if start is None:
        start = 1

    if end is None:
        end = max(regular_numbers)

    if start > end:
        raise RuntimeError(
            f"Invalid track range {start}-{end}."
        )

    selected = []

    for number in range(start, end + 1):
        selected.append(
            find_requested_track(
                tracks,
                number,
            )
        )

    return selected


def format_track_numbers(selected_tracks):
    first = selected_tracks[0]["number"]
    last = selected_tracks[-1]["number"]

    if first == last:
        return f"{first:02d}"

    return f"{first:02d}-{last:02d}"


def build_output_jobs(
    selected_tracks,
    batch,
    output=None,
    output_directory=None,
):
    directory = (
        Path.cwd()
        if output_directory is None
        else Path(output_directory)
    )

    if batch:
        return [
            {
                "track": track,
                "requested_track": track["number"],
                "expected_sectors": track["length"],
                "wav_path": (
                    directory
                    / f"track{track['number']:02d}.wav"
                ).resolve(),
            }
            for track in selected_tracks
        ]

    first_track = selected_tracks[0]
    logical_sectors = (
        selected_tracks[-1]["end"]
        - first_track["begin"]
    )
    wav_path = (
        Path(output).expanduser().resolve()
        if output is not None
        else (
            directory
            / (
                f"track{first_track['number']:02d}.wav"
                if len(selected_tracks) == 1
                else "track.wav"
            )
        ).resolve()
    )

    return [
        {
            "track": None,
            "requested_track": first_track["number"],
            "expected_sectors": logical_sectors,
            "wav_path": wav_path,
        }
    ]


